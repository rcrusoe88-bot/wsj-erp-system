FROM node:18-alpine AS builder
WORKDIR /app
COPY 05-frontend/package*.json ./
RUN npm ci
COPY 05-frontend/ .
RUN npm run build

FROM nginx:1.25-alpine
COPY 07-deploy/nginx.conf /etc/nginx/conf.d/default.conf
COPY --from=builder /app/dist /usr/share/nginx/html
EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
