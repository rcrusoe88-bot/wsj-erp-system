generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole {
  admin
  reviewer
  operator
}

enum RecordStatus {
  active
  inactive
}

enum OrderStatus {
  draft
  pending_review
  approved
  rejected
}

enum StockCountStatus {
  draft
  pending_review
  completed
  approved
  rejected
}

enum StockInType {
  purchase
  production
  return
}

enum StockOutType {
  production_issue
  scrap
  transfer
}

enum InventoryTransactionType {
  stock_in
  stock_out
  stock_count_lock
  stock_count_unlock
  stock_count_adjustment
}

enum InventoryTransactionDirection {
  increase
  decrease
}

enum ApprovalDecision {
  approved
  rejected
}

enum ExpiryStatus {
  normal
  warning
  expired
}

enum StockStatus {
  active
  locked
}

enum BusinessType {
  stock_in_order
  stock_out_order
  stock_count_task
}

enum AuditResult {
  success
  failure
}

model User {
  id                    String                 @id @default(cuid())
  username              String                 @unique @db.VarChar(50)
  passwordHash          String                 @map("password_hash") @db.VarChar(255)
  fullName              String                 @map("full_name") @db.VarChar(100)
  role                  UserRole
  status                RecordStatus           @default(active)
  lastLoginAt           DateTime?              @map("last_login_at") @db.Timestamptz(6)
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdMaterials      Material[]             @relation("MaterialCreatedBy")
  updatedMaterials      Material[]             @relation("MaterialUpdatedBy")
  createdWarehouses     Warehouse[]            @relation("WarehouseCreatedBy")
  updatedWarehouses     Warehouse[]            @relation("WarehouseUpdatedBy")
  stockInOrders         StockInOrder[]
  stockOutOrders        StockOutOrder[]
  approvalRecords       ApprovalRecord[]
  inventoryTransactions InventoryTransaction[] @relation("InventoryTransactionOperator")
  stockCountTasks       StockCountTask[]
  auditLogs             AuditLog[]

  @@map("users")
}

model Material {
  id                    String                   @id @default(cuid())
  materialCode          String                   @unique @map("material_code") @db.VarChar(50)
  materialName          String                   @map("material_name") @db.VarChar(100)
  materialCategory      String                   @map("material_category") @db.VarChar(50)
  specification         String?                  @db.VarChar(255)
  unit                  String                   @db.VarChar(50)
  batchManaged          Boolean                  @default(true) @map("batch_managed")
  expiryManaged         Boolean                  @default(true) @map("expiry_managed")
  storageCondition      String?                  @map("storage_condition") @db.VarChar(255)
  status                RecordStatus             @default(active)
  remark                String?                  @db.Text
  createdById           String                   @map("created_by_id")
  updatedById           String?                  @map("updated_by_id")
  createdAt             DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             User                     @relation("MaterialCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?                    @relation("MaterialUpdatedBy", fields: [updatedById], references: [id])
  stockInOrderItems     StockInOrderItem[]
  stockInItemSources    StockInOrderItemSource[] @relation("SourceMaterial")
  stockOutOrderItems    StockOutOrderItem[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  upstreamTraceLinks    BatchTraceLink[]         @relation("BatchTraceUpstreamMaterial")
  downstreamTraceLinks  BatchTraceLink[]         @relation("BatchTraceDownstreamMaterial")

  @@map("materials")
}

model Warehouse {
  id                    String                 @id @default(cuid())
  warehouseCode         String                 @unique @map("warehouse_code") @db.VarChar(50)
  warehouseName         String                 @map("warehouse_name") @db.VarChar(100)
  location              String?                @db.VarChar(255)
  status                RecordStatus           @default(active)
  remark                String?                @db.Text
  createdById           String                 @map("created_by_id")
  updatedById           String?                @map("updated_by_id")
  createdAt             DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime               @updatedAt @map("updated_at") @db.Timestamptz(6)
  createdBy             User                   @relation("WarehouseCreatedBy", fields: [createdById], references: [id])
  updatedBy             User?                  @relation("WarehouseUpdatedBy", fields: [updatedById], references: [id])
  stockInOrders         StockInOrder[]
  stockOutOrders        StockOutOrder[]
  inventoryBalances     InventoryBalance[]
  inventoryTransactions InventoryTransaction[]
  stockCountTasks       StockCountTask[]

  @@map("warehouses")
}

model StockInOrder {
  id              String             @id @default(cuid())
  orderNo         String             @unique @map("order_no") @db.VarChar(50)
  stockInType     StockInType        @map("stock_in_type")
  status          OrderStatus        @default(draft)
  applicantId     String             @map("applicant_id")
  warehouseId     String             @map("warehouse_id")
  sourceReference String?            @map("source_reference") @db.VarChar(100)
  submittedAt     DateTime?          @map("submitted_at") @db.Timestamptz(6)
  approvedAt      DateTime?          @map("approved_at") @db.Timestamptz(6)
  rejectedAt      DateTime?          @map("rejected_at") @db.Timestamptz(6)
  remark          String?            @db.Text
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicant       User               @relation(fields: [applicantId], references: [id])
  warehouse       Warehouse          @relation(fields: [warehouseId], references: [id])
  items           StockInOrderItem[]

  @@index([status, submittedAt(sort: Desc)])
  @@index([applicantId, createdAt(sort: Desc)])
  @@map("stock_in_orders")
}

model StockInOrderItem {
  id             String                   @id @default(cuid())
  stockInOrderId String                   @map("stock_in_order_id")
  materialId     String                   @map("material_id")
  lotNumber      String                   @map("lot_number") @db.VarChar(100)
  quantity       Decimal                  @db.Decimal(18, 6)
  unit           String                   @db.VarChar(50)
  productionDate DateTime?                @map("production_date") @db.Date
  expiryDate     DateTime?                @map("expiry_date") @db.Date
  remark         String?                  @db.Text
  createdAt      DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  stockInOrder   StockInOrder             @relation(fields: [stockInOrderId], references: [id])
  material       Material                 @relation(fields: [materialId], references: [id])
  sources        StockInOrderItemSource[]

  @@index([stockInOrderId])
  @@index([materialId])
  @@map("stock_in_order_items")
}

model StockInOrderItemSource {
  id                 String           @id @default(cuid())
  stockInOrderItemId String           @map("stock_in_order_item_id")
  upstreamMaterialId String           @map("upstream_material_id")
  upstreamLotNumber  String           @map("upstream_lot_number") @db.VarChar(100)
  consumedQuantity   Decimal          @map("consumed_quantity") @db.Decimal(18, 6)
  remark             String?          @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  stockInOrderItem   StockInOrderItem @relation(fields: [stockInOrderItemId], references: [id])
  upstreamMaterial   Material         @relation("SourceMaterial", fields: [upstreamMaterialId], references: [id])

  @@index([stockInOrderItemId])
  @@index([upstreamMaterialId, upstreamLotNumber])
  @@map("stock_in_order_item_sources")
}

model StockOutOrder {
  id           String              @id @default(cuid())
  orderNo      String              @unique @map("order_no") @db.VarChar(50)
  stockOutType StockOutType        @map("stock_out_type")
  status       OrderStatus         @default(draft)
  applicantId  String              @map("applicant_id")
  warehouseId  String              @map("warehouse_id")
  destination  String              @db.VarChar(255)
  submittedAt  DateTime?           @map("submitted_at") @db.Timestamptz(6)
  approvedAt   DateTime?           @map("approved_at") @db.Timestamptz(6)
  rejectedAt   DateTime?           @map("rejected_at") @db.Timestamptz(6)
  remark       String?             @db.Text
  createdAt    DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime            @updatedAt @map("updated_at") @db.Timestamptz(6)
  applicant    User                @relation(fields: [applicantId], references: [id])
  warehouse    Warehouse           @relation(fields: [warehouseId], references: [id])
  items        StockOutOrderItem[]

  @@index([status, submittedAt(sort: Desc)])
  @@index([applicantId, createdAt(sort: Desc)])
  @@map("stock_out_orders")
}

model StockOutOrderItem {
  id              String        @id @default(cuid())
  stockOutOrderId String        @map("stock_out_order_id")
  materialId      String        @map("material_id")
  lotNumber       String        @map("lot_number") @db.VarChar(100)
  quantity        Decimal       @db.Decimal(18, 6)
  unit            String        @db.VarChar(50)
  remark          String?       @db.Text
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  stockOutOrder   StockOutOrder @relation(fields: [stockOutOrderId], references: [id])
  material        Material      @relation(fields: [materialId], references: [id])

  @@index([stockOutOrderId])
  @@index([materialId])
  @@map("stock_out_order_items")
}

model ApprovalRecord {
  id             String           @id @default(cuid())
  businessType   BusinessType     @map("business_type")
  businessId     String           @map("business_id")
  reviewStep     Int              @default(1) @map("review_step")
  reviewerId     String           @map("reviewer_id")
  decision       ApprovalDecision
  decisionReason String?          @map("decision_reason") @db.Text
  reviewedAt     DateTime         @map("reviewed_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  reviewer       User             @relation(fields: [reviewerId], references: [id])

  @@index([businessType, businessId])
  @@index([reviewerId, reviewedAt(sort: Desc)])
  @@map("approval_records")
}

model InventoryBalance {
  id                String           @id @default(cuid())
  materialId        String           @map("material_id")
  warehouseId       String           @map("warehouse_id")
  lotNumber         String           @map("lot_number") @db.VarChar(100)
  quantityOnHand    Decimal          @default(0) @map("quantity_on_hand") @db.Decimal(18, 6)
  quantityAvailable Decimal          @default(0) @map("quantity_available") @db.Decimal(18, 6)
  quantityLocked    Decimal          @default(0) @map("quantity_locked") @db.Decimal(18, 6)
  productionDate    DateTime?        @map("production_date") @db.Date
  expiryDate        DateTime?        @map("expiry_date") @db.Date
  expiryStatus      ExpiryStatus     @default(normal) @map("expiry_status")
  stockStatus       StockStatus      @default(active) @map("stock_status")
  lastTransactionAt DateTime?        @map("last_transaction_at") @db.Timestamptz(6)
  createdAt         DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  material          Material         @relation(fields: [materialId], references: [id])
  warehouse         Warehouse        @relation(fields: [warehouseId], references: [id])
  stockCountItems   StockCountItem[]

  @@unique([materialId, warehouseId, lotNumber])
  @@index([materialId])
  @@index([warehouseId])
  @@index([expiryStatus, expiryDate])
  @@map("inventory_balances")
}

model InventoryTransaction {
  id              String                        @id @default(cuid())
  materialId      String                        @map("material_id")
  warehouseId     String                        @map("warehouse_id")
  lotNumber       String                        @map("lot_number") @db.VarChar(100)
  transactionType InventoryTransactionType      @map("transaction_type")
  direction       InventoryTransactionDirection
  quantity        Decimal                       @db.Decimal(18, 6)
  quantityBefore  Decimal                       @map("quantity_before") @db.Decimal(18, 6)
  quantityAfter   Decimal                       @map("quantity_after") @db.Decimal(18, 6)
  sourceType      BusinessType                  @map("source_type")
  sourceId        String                        @map("source_id")
  operatedById    String                        @map("operated_by")
  operatedAt      DateTime                      @default(now()) @map("operated_at") @db.Timestamptz(6)
  material        Material                      @relation(fields: [materialId], references: [id])
  warehouse       Warehouse                     @relation(fields: [warehouseId], references: [id])
  operatedBy      User                          @relation("InventoryTransactionOperator", fields: [operatedById], references: [id])

  @@index([materialId, warehouseId, lotNumber, operatedAt(sort: Desc)])
  @@index([sourceType, sourceId])
  @@map("inventory_transactions")
}

model BatchTraceLink {
  id                   String       @id @default(cuid())
  upstreamMaterialId   String       @map("upstream_material_id")
  upstreamLotNumber    String       @map("upstream_lot_number") @db.VarChar(100)
  downstreamMaterialId String       @map("downstream_material_id")
  downstreamLotNumber  String       @map("downstream_lot_number") @db.VarChar(100)
  consumedQuantity     Decimal      @map("consumed_quantity") @db.Decimal(18, 6)
  producedQuantity     Decimal      @map("produced_quantity") @db.Decimal(18, 6)
  referenceType        BusinessType @map("reference_type")
  referenceId          String       @map("reference_id")
  createdAt            DateTime     @default(now()) @map("created_at") @db.Timestamptz(6)
  upstreamMaterial     Material     @relation("BatchTraceUpstreamMaterial", fields: [upstreamMaterialId], references: [id])
  downstreamMaterial   Material     @relation("BatchTraceDownstreamMaterial", fields: [downstreamMaterialId], references: [id])

  @@index([upstreamMaterialId, upstreamLotNumber])
  @@index([downstreamMaterialId, downstreamLotNumber])
  @@map("batch_trace_links")
}

model StockCountTask {
  id          String           @id @default(cuid())
  taskNo      String           @unique @map("task_no") @db.VarChar(50)
  warehouseId String           @map("warehouse_id")
  taskScope   String           @map("task_scope") @db.VarChar(255)
  status      StockCountStatus @default(draft)
  applicantId String           @map("applicant_id")
  submittedAt DateTime?        @map("submitted_at") @db.Timestamptz(6)
  approvedAt  DateTime?        @map("approved_at") @db.Timestamptz(6)
  rejectedAt  DateTime?        @map("rejected_at") @db.Timestamptz(6)
  completedAt DateTime?        @map("completed_at") @db.Timestamptz(6)
  remark      String?          @db.Text
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  warehouse   Warehouse        @relation(fields: [warehouseId], references: [id])
  applicant   User             @relation(fields: [applicantId], references: [id])
  items       StockCountItem[]

  @@map("stock_count_tasks")
}

model StockCountItem {
  id                 String           @id @default(cuid())
  stockCountTaskId   String           @map("stock_count_task_id")
  inventoryBalanceId String           @map("inventory_balance_id")
  systemQuantity     Decimal          @map("system_quantity") @db.Decimal(18, 6)
  countedQuantity    Decimal          @map("counted_quantity") @db.Decimal(18, 6)
  varianceQuantity   Decimal          @map("variance_quantity") @db.Decimal(18, 6)
  varianceReason     String?          @map("variance_reason") @db.Text
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  stockCountTask     StockCountTask   @relation(fields: [stockCountTaskId], references: [id])
  inventoryBalance   InventoryBalance @relation(fields: [inventoryBalanceId], references: [id])

  @@unique([stockCountTaskId, inventoryBalanceId])
  @@index([stockCountTaskId])
  @@index([inventoryBalanceId])
  @@map("stock_count_items")
}

model AuditLog {
  id         String      @id @default(cuid())
  actionType String      @map("action_type") @db.VarChar(50)
  targetType String      @map("target_type") @db.VarChar(50)
  targetId   String      @map("target_id")
  operatorId String      @map("operator_id")
  result     AuditResult
  summary    String      @db.VarChar(500)
  operatedAt DateTime    @default(now()) @map("operated_at") @db.Timestamptz(6)
  operator   User        @relation(fields: [operatorId], references: [id])

  @@index([targetType, targetId])
  @@index([operatorId, operatedAt(sort: Desc)])
  @@map("audit_logs")
}
